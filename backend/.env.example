# Copy this file to backend/.env and fill in secrets locally.
# Never commit backend/.env or put real API keys in this template.

DATABASE_PATH=data/agent.db
DOCS_ROOT=../docs
MAX_DOC_BYTES=100000
MAX_TOOL_RESULT_CHARS=20000
RUNTIME_MAX_LOOPS=12
RUNTIME_MAX_TOOL_CALLS=8
RUNTIME_MAX_DURATION_SECONDS=120
RUNTIME_TOOL_TIMEOUT_SECONDS=20

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=60

# Leave the embedding settings empty/zero to expose keyword retrieval only.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0
EMBEDDING_TIMEOUT_SECONDS=60

# Applied only to vector and hybrid retrieval. Valid range: 0..1.
# This 0.5 value is a provisional smoke-set calibration, not a final accuracy guarantee.
KNOWLEDGE_MIN_VECTOR_SIMILARITY=0.5
KNOWLEDGE_QUERY_PLANNING_ENABLED=false
KNOWLEDGE_QUERY_PLANNING_MAX_QUERIES=4
KNOWLEDGE_QUERY_PLANNING_MAX_QUERY_CHARS=300
KNOWLEDGE_CANDIDATE_LIMIT=30
KNOWLEDGE_CANDIDATE_MIN_VECTOR_SIMILARITY=0.2
KNOWLEDGE_CANDIDATE_KEYWORD_LIMIT=20
KNOWLEDGE_CANDIDATE_VECTOR_LIMIT=30
KNOWLEDGE_PIPELINE_ENABLED=false
KNOWLEDGE_ANSWERABILITY_MIN_SUPPORTED_COVERAGE=1.0
KNOWLEDGE_ANSWERABILITY_MIN_PARTIAL_COVERAGE=0.5
KNOWLEDGE_ANSWERABILITY_MIN_SUPPORTED_EVIDENCE=1
KNOWLEDGE_ANSWERABILITY_MULTI_EVIDENCE_REQUIRES_ALL_QUERIES=true
KNOWLEDGE_ANSWERABILITY_ALLOW_INSUFFICIENT_LLM=false

# Rerank is disabled by default. API keys are read from the environment only.
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_BASE_URL=
KNOWLEDGE_RERANK_MODEL=
KNOWLEDGE_RERANK_TIMEOUT_SECONDS=10
KNOWLEDGE_RERANK_CANDIDATE_LIMIT=30

DRAFT_DIRECTORY=data/drafts