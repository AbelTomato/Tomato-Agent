# 复制到 backend/.env；仅保存 Provider 凭据与连接信息，切勿提交密钥。
# 运行策略：复制 config.example.toml 到 config.local.toml。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# 可选：向量/混合检索；未配置时仅关键词检索。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0

# 可选：Provider Reranker，同时在 TOML 中启用 knowledge.rerank。
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_BASE_URL=
KNOWLEDGE_RERANK_MODEL=
